# --- Supabase (account mode). Leave blank to run in demo mode only. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used exclusively for "delete my account". Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket created by supabase/migrations/0001_init.sql
SUPABASE_STORAGE_BUCKET=medical-documents

# --- Gemini (server-only) ---
GEMINI_API_KEY=
# Required to enable AI processing: set to true ONLY for a paid-tier key. Google may use content
# sent through the unpaid tier to improve its products, so patient documents must not go there.
GEMINI_PAID_TIER=
# Verify with: npm run gemini:models
GEMINI_MODEL=gemini-3.5-flash
# Milliseconds per Gemini request before aborting
GEMINI_TIMEOUT_MS=90000
# Gemini 3+ only: minimal | low | medium | high (transcription works well on low)
GEMINI_THINKING_LEVEL=low

# --- Limits ---
MAX_UPLOAD_MB=10

# --- AI provider: empty = Gemini (needs GEMINI_PAID_TIER=true); "mock" = deterministic test extractor;
# "freellmapi" = free-tier models routed by a FreeLLMAPI server (https://github.com/tashfeenahmed/freellmapi).
# With "freellmapi" the Privacy and Subprocessors pages automatically disclose free-tier processing. ---
AFTERCARE_AI_PROVIDER=
# Router base URL ending in /v1 (must be reachable from this server; a localhost router only works locally)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# Unified key from the FreeLLMAPI dashboard (Keys page header)
FREELLMAPI_API_KEY=
# Ordered preference list, tried in turn when a model is busy, slow or returns invalid data ("auto" = router decides)
FREELLMAPI_MODEL=gpt-oss-120b,gemini-3.1-flash-lite,auto
# Same for photos (image-capable models only)
FREELLMAPI_VISION_MODEL=gemini-3.1-flash-lite,gemini-flash-lite,auto
# Timeout per model attempt (default 90000)
FREELLMAPI_TIMEOUT_MS=90000

# --- Legal identity shown on /privacy, /terms and /contact (kept out of the public repo) ---
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_COUNTRY=
NEXT_PUBLIC_LEGAL_POSTAL_ADDRESS=

# --- Transactional email (welcome emails). Gmail: smtp.gmail.com, port 465, a Google App Password. ---
# SMTP_PASS is a secret: set it only in Vercel / .env.local, never in NEXT_PUBLIC_ variables or git.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
